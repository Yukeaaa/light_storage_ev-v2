{
  "$table": "e0_full_split_registry",
  "rule_version": "e0_full_split_v1",
  "columns": [
    "session_id", "site_raw", "site", "site_canonical", "garage", "station",
    "connection_time", "connection_time_canonical", "connection_time_source",
    "disconnect_time", "field_mode", "match_status", "sample_layer", "role",
    "split", "split_rule_version", "stress", "external", "source_file",
    "anomaly_flag", "anomaly_reason"
  ],
  "unique_columns": ["session_id"],
  "constraints": {
    "split_values": ["train", "validation", "test", "external", "stress"],
    "connection_time_source_values": ["api_metadata", "first_observation_fallback"],
    "role_values": ["main", "boundary", "current_only_fallback", "external_only"],
    "field_mode_values": ["measured_pilot", "measured_no_pilot", "computed_pilot", "computed_no_pilot", "current_only"],
    "sample_layer_values": ["L1_strict_matched", "L0_static_extension"],
    "session_single_split": true,
    "external_not_in_train": true,
    "stress_not_in_main": true,
    "sample_layer_matches_match_status": true,
    "split_does_not_change_role": true,
    "role_does_not_change_split": true
  },
  "column_definitions": {
    "session_id": { "dtype": "string", "description": "会话唯一标识（同一会话绝不跨 split）" },
    "site_raw": { "dtype": "string", "description": "来源 manifest 的原始 site（caltech/jpl/office_01），不直接用于实验" },
    "site": { "dtype": "string", "description": "canonical 站点（caltech/jpl/office001）" },
    "site_canonical": { "dtype": "string", "description": "与 site 相同，审查结论15 锁定列别名" },
    "garage": { "dtype": "string", "description": "车库/桩群" },
    "station": { "dtype": "string", "description": "桩点" },
    "connection_time": { "dtype": "datetime", "description": "canonical 连接时刻（时间切分唯一依据），UTC" },
    "connection_time_canonical": { "dtype": "datetime", "description": "与 connection_time 相同，审查结论15 锁定列别名" },
    "connection_time_source": { "dtype": "string", "description": "api_metadata / first_observation_fallback" },
    "disconnect_time": { "dtype": "datetime", "description": "离场时刻（仅 matched 有 API 元数据，static_only 为空）" },
    "field_mode": { "dtype": "string", "description": "measured_pilot/computed_pilot/current_only 等冻结五类" },
    "match_status": { "dtype": "string", "description": "matched / static_only（api_only 不进入本 registry）" },
    "sample_layer": { "dtype": "string", "description": "L1_strict_matched / L0_static_extension（证据资格分离）" },
    "role": { "dtype": "string", "description": "main / boundary / current_only_fallback / external_only（独立于时间 split）" },
    "split": { "dtype": "string", "description": "train/validation/test/external/stress（时间位置，不授予训练资格）" },
    "split_rule_version": { "dtype": "string", "description": "e0_full_split_v1" },
    "stress": { "dtype": "bool", "description": "异常月份/2021 是否标记为 stress" },
    "external": { "dtype": "bool", "description": "office001 外部验证会话" },
    "source_file": { "dtype": "string", "description": "来源 manifest 文件名（logical_path）" },
    "anomaly_flag": { "dtype": "bool", "description": "API connectionTime 与首条观测矛盾时登记 anomaly（禁止自动替换）" },
    "anomaly_reason": { "dtype": "string", "description": "anomaly 原因；无 anomaly 时为空" }
  }
}
